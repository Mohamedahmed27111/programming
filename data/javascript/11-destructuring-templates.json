  },
  "terms": [
    {
      "id": "js-destructuring-templates-t001",
      "term": "destructuring",
      "level": "beginner",
      "definitionEn": "A syntax that extracts values from arrays or properties from objects into bindings.",
      "example": "const [first] = values;",
      "caseSensitive": false,
      "aliases": [
        "destructuring assignment"
      ]
    },
    {
      "id": "js-destructuring-templates-t002",
      "term": "array pattern",
      "level": "beginner",
      "definitionEn": "A bracket pattern that assigns values by their sequence positions.",
      "example": "const [a, b] = [1, 2];",
      "caseSensitive": false,
      "aliases": [
        "array destructuring"
      ]
    },
    {
      "id": "js-destructuring-templates-t003",
      "term": "object pattern",
      "level": "beginner",
      "definitionEn": "A brace pattern that assigns values based on matching property names.",
      "example": "const { name } = user;",
      "caseSensitive": false,
      "aliases": [
        "object destructuring"
      ]
    },
    {
      "id": "js-destructuring-templates-t004",
      "term": "renaming",
      "level": "intermediate",
      "definitionEn": "Choosing a different local binding name while extracting a property.",
      "example": "const { id: userId } = user;",
      "caseSensitive": false,
      "aliases": [
        "property alias"
      ]
    },
    {
      "id": "js-destructuring-templates-t005",
      "term": "default value",
      "level": "intermediate",
      "definitionEn": "A fallback used by a pattern when an extracted value is undefined.",
      "example": "const { size = 1 } = options;",
      "caseSensitive": false,
      "aliases": [
        "fallback"
      ]
    },
    {
      "id": "js-destructuring-templates-t006",
      "term": "nested destructuring",
      "level": "advanced",
      "definitionEn": "A pattern that extracts a value from a structure inside another structure.",
      "example": "const { address: { city } } = user;",
      "caseSensitive": false,
      "aliases": [
        "nested pattern"
      ]
    },
    {
      "id": "js-destructuring-templates-t007",
      "term": "template literal",
      "level": "beginner",
      "definitionEn": "A backtick-delimited string form that can contain embedded expressions.",
      "example": "const text = `Hello ${name}`;",
      "caseSensitive": false,
      "aliases": [
        "template string"
      ]
    },
    {
      "id": "js-destructuring-templates-t008",
      "term": "interpolation",
      "level": "beginner",
      "definitionEn": "An embedded expression whose value is inserted into a text template.",
      "example": "const text = `Total: ${sum}`;",
      "caseSensitive": false,
      "aliases": [
        "expression insertion"
      ]
    },
    {
      "id": "js-destructuring-templates-t009",
      "term": "rest property",
      "level": "intermediate",
      "definitionEn": "A pattern entry that gathers properties not already selected.",
      "example": "const { id, ...rest } = item;",
      "caseSensitive": false,
      "aliases": [
        "object rest"
      ]
    },
    {
      "id": "js-destructuring-templates-t010",
      "term": "parameter destructuring",
      "level": "intermediate",
      "definitionEn": "Extracting values from an argument directly in a function's parameter list.",
      "example": "function show({ name }) {}",
      "caseSensitive": false,
      "aliases": [
        "destructured parameter"
      ]
    },
    {
      "id": "js-destructuring-templates-t011",
      "term": "multiline string",
      "level": "beginner",
      "definitionEn": "Text that contains line breaks as part of its value.",
      "example": "const poem = `one\ntwo`;",
      "caseSensitive": false,
      "aliases": [
        "line-broken string"
      ]
    },
    {
      "id": "js-destructuring-templates-t012",
      "term": "binding pattern",
      "level": "intermediate",
      "definitionEn": "A structured declaration form that assigns multiple extracted values to names.",
      "example": "const [head, ...tail] = list;",
      "caseSensitive": false,
      "aliases": [
        "pattern"
      ]
    }
  ],

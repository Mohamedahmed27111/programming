    {
      "id": "js-destructuring-templates-q022",
      "type": "interview",
      "level": "interview",
      "sourceSection": "Destructuring Assignment (objects, arrays, nested, parameters)",
      "question": "How do array and object destructuring choose which values to bind?",
      "keyPoints": [
        "Array patterns match by position",
        "Object patterns match by property name",
        "Object properties can be renamed",
        "Either pattern can use defaults"
      ],
      "modelAnswer": "Array destructuring assigns by position, while object destructuring looks up properties by name. Object patterns can rename a property into a local binding, and both forms support defaults for undefined values."
    },
    {
      "id": "js-destructuring-templates-q023",
      "type": "interview",
      "level": "interview",
      "sourceSection": "Template Literals",
      "question": "What are useful features of template literals compared with quoted strings?",
      "keyPoints": [
        "Expressions can be interpolated",
        "Multiline text can be written directly",
        "Expressions use ${...}",
        "Backticks delimit the literal"
      ],
      "modelAnswer": "Template literals use backticks and allow expressions to be embedded with ${...}. They also support writing multiline text directly, which can make constructed strings easier to read."
